# panaoptions — per-machine settings. Copy to .env; .env is not tracked by git.
#
#     python run.py --set PANAOPTIONS_CAPITAL=2000

# Paper capital. Overrides account.starting_capital in config/settings.yaml.
# At the shipped 20% deployment rule, roughly what each level reaches:
#     500   nothing in the default universe (see run.py --check-config)
#     1600  the cheapest at-the-money name
#     2000  every name in the default universe
PANAOPTIONS_CAPITAL=2000

# Market data. Only needed when data.provider is "tradier" in settings.yaml.
#
# A free developer token from developer.tradier.com serves DELAYED data with
# real option chains AND greeks — which is the point: Yahoo serves no greeks
# at all, so on that path delta is estimated here rather than quoted.
#
# Blank with provider "tradier" falls back to Yahoo with an error in the log,
# never silently. A sandbox token does not work against production.
TRADIER_TOKEN=

# Alerts. Blank means nothing is sent and nothing is attempted.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=INFO
