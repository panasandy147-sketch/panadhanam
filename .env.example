# ============================================================
# panadhanam — Multi-Agent Stock & F&O Trading Intelligence
# Copy to `.env` and fill in. Everything has a safe default:
# with NO keys at all the system runs in SIMULATION + PAPER mode.
# ============================================================

# ---------- Market ----------
# IN = India (NSE)   US = United States (NYSE/NASDAQ)
# Switchable live from the dashboard; this is just the startup default.
ACTIVE_MARKET=IN

# ---------- Run mode ----------
# paper  = simulated fills, no real orders   (default, safe)
# live   = real orders via the broker adapter (requires ENABLE_LIVE_ORDERS=true)
TRADING_MODE=paper
ENABLE_LIVE_ORDERS=false

# ---------- LLM (agent reasoning) ----------
# Optional. Without any LLM the agents still run on their deterministic rule
# engines — you lose judgement, never correctness. The risk manager NEVER uses
# an LLM in any configuration.
#
# anthropic = Claude (best, paid)   ollama = local model (free, private)
# Leave blank to auto-detect: a Claude key wins, else Ollama if configured.
LLM_PROVIDER=

# --- Option A: Claude ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium

# --- Option B: Ollama — free, local, no signup. See docs/OLLAMA.md ---
#   1. install from https://ollama.com/download
#   2. ollama pull qwen2.5:7b
#   3. set LLM_PROVIDER=ollama and uncomment OLLAMA_MODEL below
#   4. python run.py --check-llm
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=180

# ---------- Broker selection ----------
# India : paper | zerodha | upstox | angelone
# US    : paper | alpaca
# A broker that does not serve the active market falls back to paper.
BROKER=paper

# --- Zerodha Kite Connect ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- Upstox ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/broker/upstox/callback

# --- Angel One SmartAPI ---
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# --- Alpaca (US markets) — free paper account with REAL data ---
# Setup: docs/ALPACA.md.  Sign up at https://alpaca.markets, switch to the
# Paper Trading toggle, then generate keys there (a paper key starts with PK).
# Nothing to pip install — the adapter is plain REST.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true        # true = simulator. Only set false for real money.
ALPACA_FEED=iex          # iex (free, partial tape) | sip (paid, full tape)

# ---------- Capital & risk (overrides config/settings.yaml) ----------
TOTAL_CAPITAL=100000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MIN_RISK_REWARD=2.0

# ---------- Server ----------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---------- Optional news APIs (RSS works with no key) ----------
NEWSAPI_KEY=
BENZINGA_KEY=
